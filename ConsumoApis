<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Consultar API's</title>
</head>
<body>
    <h1>Consulta de API's</h1>

    <button onclick="consultarAPI('https://fakerapi.it/api/v2/books?_quantity=1', 'output1')">Consultar API 1 </button>
    <div id="output1" style="margin-top: 10px; border: 1px solid #000; padding: 10px; width: 300px;"></div>
<br>

    <button onclick="consultarAPI('https://fakerapi.it/api/v2/persons?_quantity=1&_gender=female&_birthday_start=2005-01-01', 'output2')">Consultar API 2 </button>
    <div id="output2" style="margin-top: 10px; border: 1px solid #000; padding: 10px; width: 300px;"></div>
<br>
    <button onclick="consultarAPI('https://fakerapi.it/api/v2/products?_quantity=1&_taxes=12&_categories_type=uuid', 'output3')">Consultar API 3 )</button>
    <div id="output3" style="margin-top: 10px; border: 1px solid #000; padding: 10px; width: 300px;"></div>

    <script>
        function consultarAPI(url, outputId) {
            fetch(url)
                .then(response => response.json())
                .then(data => {
                    document.getElementById(outputId).innerText = JSON.stringify(data.data, null, 2);
                })
                .catch(error => {
                    document.getElementById(outputId).innerText = 'Error al consultar la API.';
                    console.log(error);
                });
        }
    </script>
</body>
</html>
